# image/tests/webp_test.mojo — real PIL-oracle verification of the WebP VP8L codec.
#
# Fixtures are generated by /tmp/webp_fixtures.py (run it FIRST). Each fixture has
# a lossless .webp (/tmp/webp_fix/<name>.webp) and an expected-pixel dump
# (<name>.pix):
#   line 1: "W H 4"  (always RGBA in the comparison mode)
#   then W*H*4 integer sample values, row-major, channel-interleaved (R G B A).
#
# 1) decode each lossless WebP with our Mojo decode_webp and compare PIXEL-EXACT
#    to PIL's RGBA pixels (the oracle). Lossless ⇒ must be byte-exact.
# 2) round-trip: encode_webp_bytes(decoded) -> decode_webp_bytes -> compare to
#    the same expected pixels (our encoder is lossless).
# Also write a Mojo-encoded .webp to disk for an external PIL pass.

from image.buffer import Image
from image.webp import decode_webp, decode_webp_bytes, encode_webp_bytes, encode_webp


def _load_expected(path: String) raises -> List[Int]:
    var f = open(path, "r")
    var d = f.read_bytes()
    f.close()
    var out = List[Int]()
    var cur = 0
    var have = False
    var neg = False
    for i in range(len(d)):
        var ch = Int(d[i])
        if ch == 32 or ch == 10 or ch == 13 or ch == 9:
            if have:
                out.append(-cur if neg else cur)
                cur = 0
                have = False
                neg = False
        elif ch == 45:
            neg = True
            have = True
        elif ch >= 48 and ch <= 57:
            cur = cur * 10 + (ch - 48)
            have = True
    if have:
        out.append(-cur if neg else cur)
    return out^


def _compare(img: Image, exp: List[Int], name: String) raises -> Int:
    """Returns 1 on pass, 0 on fail (prints details)."""
    var w = exp[0]
    var h = exp[1]
    var c = exp[2]
    if img.width != w or img.height != h or img.channels != c:
        print("  FAIL", name, "shape: got", img.width, "x", img.height, "x",
              img.channels, "expected", w, "x", h, "x", c)
        return 0
    var mism = 0
    var idx = 3
    var first_x = -1
    var first_y = -1
    for y in range(h):
        for x in range(w):
            for ch in range(c):
                var got = Int(img.get(x, y, ch))
                var want = exp[idx]
                idx += 1
                if got != want:
                    mism += 1
                    if first_x < 0:
                        first_x = x
                        first_y = y
    if mism == 0:
        print("  pass", name, "(" + String(w) + "x" + String(h) + "x" +
              String(c) + " pixel-exact)")
        return 1
    else:
        print("  FAIL", name, "mismatches:", mism, "of", w * h * c,
              "first at (", first_x, ",", first_y, ")")
        return 0


def main() raises:
    var base = String("/tmp/webp_fix")
    var p = 0
    var f = 0

    print("== WebP VP8L codec verification (PIL oracle) ==")

    var names = ["gradient_rgba", "flat_rgb", "small_rgba", "blocks_rgb"]
    for ni in range(len(names)):
        var name = names[ni]
        var webp_path = base + "/" + name + ".webp"
        var pix_path = base + "/" + name + ".pix"
        var exp = _load_expected(pix_path)

        # 1) decode PIL's lossless webp -> compare pixel-exact
        var img = decode_webp(webp_path)
        var r1 = _compare(img, exp, "decode:" + name)
        if r1 == 1:
            p += 1
        else:
            f += 1

        # 2) round-trip our encoder: encode -> decode -> compare
        var bytes = encode_webp_bytes(img)
        var img2 = decode_webp_bytes(bytes)
        var r2 = _compare(img2, exp, "roundtrip:" + name)
        if r2 == 1:
            p += 1
        else:
            f += 1

        # write Mojo-encoded webp for an external PIL pass
        encode_webp(img, base + "/" + name + ".mojoenc.webp")

    print("passed:", p, "failed:", f)
    if f == 0:
        print("ALL WEBP TESTS PASSED")
