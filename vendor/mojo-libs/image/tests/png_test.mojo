# image/tests/png_test.mojo — real PIL-oracle verification of the PNG codec.
#
# Fixtures are generated by /tmp/png_fixtures.py (run it first). Each fixture has
# a PNG (/tmp/png_fix/<name>.png) and an expected-pixel dump (<name>.pix):
#   line 1: "W H C"  (C = channels in the comparison mode)
#   then W*H*C integer sample values, row-major, channel-interleaved.
#
# We decode each PNG with our Mojo decode_png and compare pixel-exact against the
# .pix (the PIL oracle). Then we round-trip encode->decode and re-compare.
#
# 16-bit fixture (i16): compared against PIL's 8-bit HIGH-BYTE downscale — our
# decoder is documented as downscaling 16-bit to 8-bit by taking the high byte.

from image.buffer import Image
from image.png import decode_png, encode_png_bytes, decode_png_bytes, encode_png


def _load_expected(path: String) raises -> List[Int]:
    """Parse the .pix file (whitespace-separated ints: W H C then samples)
    directly from bytes. Returns [W, H, C, v0, v1, ...]."""
    var f = open(path, "r")
    var d = f.read_bytes()
    f.close()
    var out = List[Int]()
    var cur = 0
    var have = False
    var neg = False
    for i in range(len(d)):
        var ch = Int(d[i])
        if ch == 32 or ch == 10 or ch == 13 or ch == 9:  # space/newline/cr/tab
            if have:
                out.append(-cur if neg else cur)
                cur = 0
                have = False
                neg = False
        elif ch == 45:  # '-'
            neg = True
            have = True
        elif ch >= 48 and ch <= 57:
            cur = cur * 10 + (ch - 48)
            have = True
    if have:
        out.append(-cur if neg else cur)
    return out^


def _compare(img: Image, exp: List[Int], name: String, mut p: Int, mut f: Int) raises:
    var w = exp[0]
    var h = exp[1]
    var c = exp[2]
    var ok = True
    var mism = 0
    if img.width != w or img.height != h or img.channels != c:
        print("  FAIL", name, "shape: got", img.width, "x", img.height, "x",
              img.channels, "expected", w, "x", h, "x", c)
        f += 1
        return
    var idx = 3
    for y in range(h):
        for x in range(w):
            for ch in range(c):
                var got = Int(img.get(x, y, ch))
                var want = exp[idx]
                idx += 1
                if got != want:
                    ok = False
                    mism += 1
    if ok:
        p += 1
        print("  pass", name, "(" + String(w) + "x" + String(h) + "x" +
              String(c) + " pixel-exact)")
    else:
        f += 1
        print("  FAIL", name, "mismatches:", mism)


def _test_fixture(
    base: String, name: String, mut p: Int, mut f: Int
) raises:
    var png_path = base + "/" + name + ".png"
    var pix_path = base + "/" + name + ".pix"
    var exp = _load_expected(pix_path)
    # decode
    var img = decode_png(png_path)
    _compare(img, exp, "decode:" + name, p, f)
    # round-trip: encode -> decode -> compare to same expected pixels
    var bytes = encode_png_bytes(img)
    var img2 = decode_png_bytes(bytes)
    _compare(img2, exp, "roundtrip:" + name, p, f)
    # also write the Mojo-encoded PNG to disk so an external PIL pass can open it
    encode_png(img, base + "/" + name + ".mojoenc.png")


def main() raises:
    var base = String("/tmp/png_fix")
    var p = 0
    var f = 0

    print("== PNG codec verification (PIL oracle) ==")
    _test_fixture(base, "rgb", p, f)
    _test_fixture(base, "rgba", p, f)
    _test_fixture(base, "gray", p, f)
    _test_fixture(base, "palette", p, f)
    _test_fixture(base, "interlaced", p, f)
    _test_fixture(base, "i16", p, f)         # 16-bit -> 8-bit high-byte downscale
    _test_fixture(base, "gray1", p, f)       # sub-byte depth 1
    _test_fixture(base, "gray2", p, f)       # sub-byte depth 2
    _test_fixture(base, "gray4", p, f)       # sub-byte depth 4

    print("passed:", p, "failed:", f)
    if f == 0:
        print("ALL PNG TESTS PASSED")
