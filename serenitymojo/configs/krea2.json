{
  "schema": "serenity.model-defaults.v1",
  "model_type": "krea2",
  "checkpoint": "models/krea2/raw.safetensors",
  "vae": "models/qwen-image/vae",
  "validation_prompts_file": "serenitymojo/configs/krea2_samples.json",

  "inner_dim": 6144,
  "in_channels": 64,
  "joint_attention_dim": 2560,
  "out_channels": 64,
  "num_double": 0,
  "num_single": 28,
  "num_heads": 48,
  "head_dim": 128,
  "mlp_hidden": 16384,
  "timestep_dim": 256,
  "rope_theta": 1000,

  "training_method": "LORA",
  "resolution": "512",
  "batch_size": 1,
  "learning_rate": 0.0001,
  "learning_rate_scheduler": "constant",
  "learning_rate_warmup_steps": 0,
  "lora_rank": 16,
  "lora_alpha": 16,
  "timestep_shift": 1.0,
  "max_grad_norm": 1.0,
  "max_steps": 2000,
  "save_every": 500,
  "sample_every": 500,
  "caption_dropout_prob": 0.0,
  "quantized_resident": "fp8_e4m3",
  "optimizer": {
    "optimizer": "ADAMW",
    "eps": 1e-8,
    "weight_decay": 0.01,
    "beta1": 0.9,
    "beta2": 0.999
  }
}
