# image/tests/jpeg_test.mojo — real PIL-oracle verification of the JPEG decoder.
#
# Fixtures are generated by /tmp/jpg_fixtures.py (run it first). Each fixture has
# a baseline JPEG (/tmp/jpg_fix/<name>.jpg) and an expected-pixel dump
# (<name>.pix) which is PIL's OWN decode of that same file:
#   line 1: "W H C"
#   then W*H*C integer sample values, row-major, channel-interleaved.
#
# We decode each JPEG with our Mojo decode_jpeg, assert dimensions match, then
# compute PSNR vs PIL's decode (two correct baseline decoders of the same file
# differ only by IDCT/upsample rounding). Bar: PSNR >= 38 dB.

from image.buffer import Image
from image.jpeg import decode_jpeg
from std.math import log10, sqrt


def _load_expected(path: String) raises -> List[Int]:
    """Parse the .pix file (whitespace-separated ints: W H C then samples)."""
    var f = open(path, "r")
    var d = f.read_bytes()
    f.close()
    var out = List[Int]()
    var cur = 0
    var have = False
    var neg = False
    for i in range(len(d)):
        var ch = Int(d[i])
        if ch == 32 or ch == 10 or ch == 13 or ch == 9:
            if have:
                out.append(-cur if neg else cur)
                cur = 0
                have = False
                neg = False
        elif ch == 45:
            neg = True
            have = True
        elif ch >= 48 and ch <= 57:
            cur = cur * 10 + (ch - 48)
            have = True
    if have:
        out.append(-cur if neg else cur)
    return out^


def _psnr(img: Image, exp: List[Int], name: String, mut p: Int, mut f: Int) raises:
    var w = exp[0]
    var h = exp[1]
    var c = exp[2]
    if img.width != w or img.height != h or img.channels != c:
        print("  FAIL", name, "shape: got", img.width, "x", img.height, "x",
              img.channels, "expected", w, "x", h, "x", c)
        f += 1
        return
    var idx = 3
    var sse: Float64 = 0.0
    var n = 0
    for y in range(h):
        for x in range(w):
            for ch in range(c):
                var got = Int(img.get(x, y, ch))
                var want = exp[idx]
                idx += 1
                var diff = Float64(got - want)
                sse += diff * diff
                n += 1
    var mse = sse / Float64(n)
    var psnr: Float64 = 999.0
    if mse > 0.0:
        psnr = 10.0 * log10(255.0 * 255.0 / mse)
    if psnr >= 38.0:
        p += 1
        print("  pass", name, "PSNR =", psnr, "dB  (" + String(w) + "x" +
              String(h) + "x" + String(c) + ")")
    else:
        f += 1
        print("  FAIL", name, "PSNR =", psnr, "dB  (below 38 dB)")


def _test_fixture(base: String, name: String, mut p: Int, mut f: Int) raises:
    var jpg_path = base + "/" + name + ".jpg"
    var pix_path = base + "/" + name + ".pix"
    var exp = _load_expected(pix_path)
    var img = decode_jpeg(jpg_path)
    _psnr(img, exp, name, p, f)


def main() raises:
    var base = String("/tmp/jpg_fix")
    var p = 0
    var f = 0

    print("== JPEG baseline decoder verification (PIL oracle, PSNR >= 38 dB) ==")
    _test_fixture(base, "q90_444", p, f)   # 4:4:4
    _test_fixture(base, "q90_422", p, f)   # 4:2:2
    _test_fixture(base, "q90_420", p, f)   # 4:2:0
    _test_fixture(base, "q90_gray", p, f)  # grayscale (1 component)
    _test_fixture(base, "q90_rst", p, f)   # restart interval (4:2:0 + DRI/RSTn)

    print("passed:", p, "failed:", f)
    if f == 0:
        print("ALL JPEG TESTS PASSED")
