# image/tests/exif_test.mojo — real PIL-oracle verification of the EXIF codec.
#
# Fixtures are generated by image/tests/exif_fixtures.py (run it first). It writes
# two reference TIFF/EXIF blobs to /tmp/exif_fix/:
#   ref_le.exif  little-endian (II), with an ExifIFD sub-IFD (RATIONAL FNumber,
#                FocalLength, ExposureTime + SHORT ISO/PixelXDimension)
#   ref_be.exif  big-endian (MM), same tags
# Both are confirmed readable by PIL (Make/Model/Orientation/DateTime + the
# rationals) in the fixture generator itself.
#
# Test:
#   1. parse_exif both blobs -> assert Make/Model/Orientation/DateTime + the
#      rationals (FNumber=2.8, FocalLength=50, ISO=100) match. Exercises BOTH
#      byte orders and the ExifIFD sub-IFD follow.
#   2. Round-trip: build_exif(...) -> Mojo parse_exif returns the same tags; the
#      python driver (exif_fixtures.py verify) confirms PIL reads our blob too.

from image.exif import (
    parse_exif,
    build_exif,
    ExifData,
    Rational,
    TAG_MAKE,
    TAG_MODEL,
    TAG_ORIENTATION,
    TAG_DATETIME,
    TAG_FNUMBER,
    TAG_FOCAL_LENGTH,
    TAG_ISO,
    TAG_EXPOSURE_TIME,
    TAG_PIXEL_X,
)


def _read_file(path: String) raises -> List[UInt8]:
    var f = open(path, "r")
    var d = f.read_bytes()
    f.close()
    var out = List[UInt8]()
    for i in range(len(d)):
        out.append(d[i])
    return out^


def _check_str(name: String, got: String, want: String, mut p: Int, mut f: Int):
    if got == want:
        p += 1
        print("  pass", name, "=", got)
    else:
        f += 1
        print("  FAIL", name, "got '" + got + "' want '" + want + "'")


def _check_int(name: String, got: Int, want: Int, mut p: Int, mut f: Int):
    if got == want:
        p += 1
        print("  pass", name, "=", got)
    else:
        f += 1
        print("  FAIL", name, "got", got, "want", want)


def _check_close(
    name: String, got: Float64, want: Float64, mut p: Int, mut f: Int
):
    var d = got - want
    if d < 0.0:
        d = -d
    if d < 0.001:
        p += 1
        print("  pass", name, "=", got)
    else:
        f += 1
        print("  FAIL", name, "got", got, "want", want)


def _verify_blob(label: String, blob: List[UInt8], mut p: Int, mut f: Int) raises:
    var bo = String("II") if blob[0] == UInt8(ord("I")) else String("MM")
    print("==", label, "(parse, byte-order", bo, ") ==")
    var ex = parse_exif(blob)
    print("  byteorder little =", ex.little)

    _check_str("Make", ex.make(), "MojoCam", p, f)
    _check_str("Model", ex.model(), "X1", p, f)
    _check_int("Orientation", ex.orientation(), 6, p, f)
    _check_str("DateTime", ex.datetime(), "2026:06:10 12:34:56", p, f)

    var fnum = ex.fnumber()
    print("    FNumber rational =", fnum.num, "/", fnum.den)
    _check_close("FNumber", fnum.as_float(), 2.8, p, f)

    var fl = ex.focal_length()
    print("    FocalLength rational =", fl.num, "/", fl.den)
    _check_close("FocalLength", fl.as_float(), 50.0, p, f)

    _check_int("ISO", ex.iso(), 100, p, f)

    var et = ex.exposure_time()
    print("    ExposureTime rational =", et.num, "/", et.den)
    _check_close("ExposureTime", et.as_float(), 0.005, p, f)

    _check_int("PixelXDimension", ex.pixel_x_dimension(), 640, p, f)

    # has()
    if ex.has(TAG_MAKE) and not ex.has(0x1234):
        p += 1
        print("  pass has() lookup")
    else:
        f += 1
        print("  FAIL has() lookup")


def main() raises:
    var p = 0
    var f = 0
    print("== EXIF codec verification (PIL oracle) ==")

    # ---- 1. parse PIL-verified reference blobs, both byte orders ----
    var le = _read_file("/tmp/exif_fix/ref_le.exif")
    _verify_blob("ref_le", le, p, f)

    var be = _read_file("/tmp/exif_fix/ref_be.exif")
    _verify_blob("ref_be", be, p, f)

    # ---- 2. round-trip: build_exif -> parse_exif ----
    print("== round-trip: build_exif -> parse_exif ==")
    var built = build_exif(
        Make="MojoCam", Model="X1", Orientation=6,
        DateTime="2026:06:10 12:00:00",
    )
    # write to disk for the PIL driver
    var of = open("/tmp/exif_fix/mojo_built.exif", "w")
    of.write_bytes(Span(built))
    of.close()
    print("  wrote /tmp/exif_fix/mojo_built.exif (" + String(len(built)) + " bytes)")

    var rt = parse_exif(built)
    _check_str("rt Make", rt.make(), "MojoCam", p, f)
    _check_str("rt Model", rt.model(), "X1", p, f)
    _check_int("rt Orientation", rt.orientation(), 6, p, f)
    _check_str("rt DateTime", rt.datetime(), "2026:06:10 12:00:00", p, f)

    print("passed:", p, "failed:", f)
    if f == 0:
        print("ALL EXIF TESTS PASSED")
